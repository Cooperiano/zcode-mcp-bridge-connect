# Reference only: server.py does not load .env automatically.
# Set variables in your MCP client; keep existing device-local login/model settings.
# Do not put live credentials in this example or commit private reports/configs.

AGENT_MCP_DEFAULT_BACKEND=zcode
AGENT_MCP_TIMEOUT=900
AGENT_MCP_MAX_CONCURRENCY=0

# Native install overrides; use absolute paths on this device.
# Windows must supply its own installation root and ZCode.exe path explicitly.
# ZCODE_APP_PATH=/absolute/path/to/ZCode
# ZCODE_BINARY=/absolute/path/to/ZCode/runtime
# ZCODE_CLI_BUNDLE=/absolute/path/to/ZCode/resources/glm/zcode.cjs

# CLI 0.16.9 modern manual compatibility. Required builtin is from this install.
# macOS path includes Contents/Resources/config/provider/zcode-builtin.json.
# ZCODE_BRIDGE_MODERN_PROTOCOL=1
# ZCODE_BUILTIN_PROVIDER_CONFIG_FILE=/absolute/path/to/resources/config/provider/zcode-builtin.json

# Fingerprinted Windows 3.14.5 managed personal-account compatibility.
# All three values are required; host/CLI hashes are also enforced.
# Do not enable OAuth alone: that selects the unaccepted experimental PAT path.
# ZCODE_BRIDGE_DESKTOP_OAUTH=1
# ZCODE_BRIDGE_PRODUCT_VERSION=3.14.5
# ZCODE_BRIDGE_INSTALLED_ACCOUNT=3.14.5

# Optional private runtime destinations. Never commit their contents.
# AGENT_MCP_LOG=/absolute/private/path/bridge.log
# AGENT_MCP_LEASE_DB=/absolute/private/path/leases.sqlite

# Legacy aliases for timeout, concurrency, log, and lease database respectively.
# Prefer AGENT_MCP_* names; those take precedence over these aliases.
# ZCODE_MCP_TIMEOUT=900
# ZCODE_MCP_MAX_CONCURRENCY=0
# ZCODE_MCP_LOG=/absolute/private/path/bridge.log
# ZCODE_MCP_LEASE_DB=/absolute/private/path/leases.sqlite

# Existing native credential derivation secret, if the native installation uses it.
# Do not invent/change it or use it to migrate/share an account.
# ZCODE_CREDENTIAL_SECRET=

# Other retained upstream backends (outside this release's live acceptance scope).
# OPENCODE_BINARY=/absolute/path/to/opencode
# PI_BINARY=/absolute/path/to/pi
# PI_BRIDGE_SESSION_DIR=/absolute/private/path/bridge-sessions
# PI_MODEL_DEPLOYMENTS_FILE=/absolute/private/path/model-deployments.json
# DEEPSEEK_API_KEY=

# Test-only Node executable override; no provider credentials required.
# NODE_BINARY=/absolute/path/to/node

# Plugin clients generate ZCODE_PLUGIN_ROOT for plugin.json path expansion.
# Manual Codex registration should use an absolute server.py path instead.
# ZCODE_PLUGIN_ROOT=/absolute/path/to/zcode-mcp-bridge-connect

# Internal generated environment; do not configure these by hand:
# ZCODE_PERSONAL_PROVIDER_CONFIG_FILE: selected private native config/projection.
# ELECTRON_RUN_AS_NODE, NO_COLOR: native subprocess runtime conventions.
# AGENT_BRIDGE_CWD, AGENT_BRIDGE_WORKSPACE_ACCESS, AGENT_BRIDGE_MODE:
#   retained Pi extension's per-run working directory/access/mode.
# AGENT_BRIDGE_ALLOWED_ROOTS, AGENT_BRIDGE_ROOT_MODES:
#   retained Pi extension's per-run JSON permission projection.
# ZCODE_MODEL: ambient override is removed by the bridge to preserve selection.

# Optional local setup.sh interpreter override (not a provider credential).
# PYTHON=/absolute/path/to/python3
